<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Semi-transparent Frosted Glass Canvas -->
    <gradient
        android:angle="270"
        android:startColor="#E6FFFFFF"
        android:centerColor="#B8FFFFFF"
        android:endColor="#99F8F5EE"
        android:type="linear" />
    <corners android:radius="26dp" />
    <!-- Refractive Glass Specular Rim Stroke -->
    <stroke
        android:width="1.5dp"
        android:color="#F2FFFFFF" />
</shape>
