<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/btn_buddy_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@android:color/transparent"
    android:padding="4dp">

    <!-- Round Gradient Button -->
    <ImageView
        android:id="@+id/iv_buddy_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/widget_circle_buddy_bg"
        android:src="@drawable/ic_widget_sparkle"
        android:scaleType="fitCenter"
        android:padding="14dp"
        android:contentDescription="@string/widget_buddy_label" />

    <!-- Dusk Buddy Label Below -->
    <TextView
        android:id="@+id/tv_buddy_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/widget_buddy_label"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:shadowColor="#B3000000"
        android:shadowDx="0"
        android:shadowDy="1.2"
        android:shadowRadius="3" />

</LinearLayout>
